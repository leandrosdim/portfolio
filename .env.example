# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend configuration
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL_FROM=contact@yourdomain.com
CONTACT_EMAIL_TO=you@yourdomain.com

# Cloudflare Turnstile (optional but recommended for spam protection)
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key